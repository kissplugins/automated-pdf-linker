{
    "name": "kissplugins/automated-pdf-linker",
    "description": "WordPress plugin that scans selected upload directories for PDF files and provides a shortcode to link to them using fuzzy matching.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "KISS / Neochrome, Inc.",
            "homepage": "https://example.com/"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "wp-coding-standards/wpcs": "^3.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "KissPlugins\\AutomatedPdfLinker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KissPlugins\\AutomatedPdfLinker\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs --standard=WordPress src/",
        "cbf": "phpcbf --standard=WordPress src/"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
